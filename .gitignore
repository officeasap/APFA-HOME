# Initialize Git if not already done
git init

# Add a .gitignore file (based on your logs snippet)
echo "
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
" > .gitignore

# Stage all files
git add .

# Commit changes
git commit -m "Initial commit with .gitignore and project setup"

# Add remote repository
git remote add origin https://github.com/officeasap/APFA-1.git

# Push to GitHub (main branch)
git push -u origin main
.env

.vercel

supabase/.temp/
